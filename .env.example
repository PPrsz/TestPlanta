# Exemplo de Configuração de Ambiente para PlantCare AI
# Copie este arquivo para .env e preencha com suas credenciais

# Chave oficial da API Google Gemini (Obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini primário e alternativas para contingência/fallback
PRIMARY_GEMINI_MODEL=gemini-3.8-flash
FALLBACK_GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Caminho para o modelo exportado do Google Teachable Machine (SavedModel)
TEACHABLE_MACHINE_MODEL_PATH=.
TEACHABLE_MACHINE_LABELS_FILE=labels.txt

# Limiares de incerteza do classificador local
TM_CONFIDENCE_THRESHOLD=0.65
TM_AMBIGUITY_MARGIN=0.15
